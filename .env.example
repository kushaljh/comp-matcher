# ── Supabase project ──────────────────────────────────────────────
# Create a free project at https://supabase.com/dashboard, then copy
# these from Project Settings -> API. Save this file as `.env`.

# Safe to ship in the app bundle (EXPO_PUBLIC_* is embedded at build time)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Maintenance mode ──────────────────────────────────────────────
# THE switch (features/maintenance/config.ts only holds the off fallback).
# true/1/on serves the holding screen instead of the app. In production this
# is set on Vercel, not here; either way it is inlined at build time, so a
# change needs a redeploy to take effect.
EXPO_PUBLIC_MAINTENANCE_MODE=false

# ── Server-side only (scripts/, migrations, tests) — NEVER in the app ──
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres URL (Project Settings -> Database -> Connection string)
# used for applying migrations and running RLS tests
SUPABASE_DB_URL=postgresql://postgres:YOUR-DB-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres
